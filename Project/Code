#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <fcntl.h>
#include <string.h>

int main()
{
    pid_t pid;
    int status;
    int fd;
    char buffer[200];

    printf("\n===== SYSTEM CALLS DEMONSTRATION =====\n");
    printf("Parent Process ID: %d\n", getpid());

    pid = fork();

    if (pid < 0)
    {
        perror("Fork failed");
        return 1;
    }
    else if (pid == 0)
    {
        printf("\nChild Process Created!\n");
        printf("Child Process ID: %d\n", getpid());

        printf("Executing new program using exec()\n");

        execl("/bin/ls", "ls", "-l", NULL);

        perror("Exec failed");
        exit(1);
    }
    else
    {
        wait(&status);
        printf("\nChild process completed.\n");
        printf("Parent process continues.\n");
    }

    fd = open("demo.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);

    if (fd < 0)
    {
        perror("Open failed");
        return 1;
    }

    char message[] = "Welcome to System Calls Project!\n";

    write(fd, message, strlen(message));
    close(fd);

    printf("\nFile created successfully.\n");

    fd = open("demo.txt", O_RDONLY);

    if (fd < 0)
    {
        perror("Open failed");
        return 1;
    }

    int bytes = read(fd, buffer, sizeof(buffer) - 1);

    if (bytes >= 0)
    {
        buffer[bytes] = '\0';
        printf("\nFile Contents:\n%s", buffer);
    }

    close(fd);

    printf("\n===== ALL SYSTEM CALLS EXECUTED =====\n");

    return 0;
}
